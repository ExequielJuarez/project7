<%- include('partials/head') %>
<section class="page-hero page-hero--img" style="--img:url('<%= gallery.about %>')">
  <div class="page-hero__bg" data-parallax="0.25"></div>
  <div class="wrap page-hero__txt"><p class="eyebrow" data-split-in>Nuestra historia</p><h1 class="display" data-split>Nosotros</h1></div>
  <div class="torn"></div>
</section>
<section class="about wrap">
  <div class="about__txt" data-reveal>
    <p class="lead">Sora nació de una idea simple: respetar el producto. Pescado fresco, arroz en su punto exacto y técnica japonesa, con un toque propio del Pacífico.</p>
    <p class="muted">Cada noche cortamos a la orden, sin apuros y sin atajos. Detrás de la barra, nuestro equipo de sushimen trabaja a la vista para que veas cómo se arma cada pieza.</p>
  </div>
  <ul class="stats" data-reveal>
    <li><strong data-count="12">0</strong><span>años de oficio</span></li>
    <li><strong data-count="40">0</strong><span>piezas en carta</span></li>
    <li><strong data-count="100">0</strong><span>% pescado del día</span></li>
  </ul>
</section>
<%- include('partials/foot') %>
