<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %></title>
  <meta name="description" content="Sora Sushi Lounge: rolls, nigiris y sashimi en un ambiente único. Mirá la carta y reservá tu mesa.">
  <meta name="theme-color" content="#0a0d0b">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <noscript><style>body.is-loading{overflow:auto}.preloader{display:none}</style></noscript>
</head>
<script>document.documentElement.classList.add("js")</script>
<body class="is-loading">
<div class="preloader" aria-hidden="true"><div class="preloader__logo">SORA</div><div class="preloader__bar"><i></i></div></div>
<div class="cursor" aria-hidden="true"><span class="cursor__dot"></span><span class="cursor__ring"><b class="cursor__label"></b></span></div>
<%- include('header') %>
